DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/attendance_db
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret

# Lightweight defaults for Acer Nitro V15 / 2GB NVIDIA GPU
INSIGHTFACE_MODEL=buffalo_s
INSIGHTFACE_DET_SIZE=320
ARCFACE_FORCE_CPU=false
TRACKER_ALGORITHM=KCF
TRACKER_DETECTION_INTERVAL=5
TRACKER_RECOGNITION_INTERVAL=18
TRACKER_MAX_TRACKERS=8

# Scanner behavior
MAX_ENCODINGS_PER_USER=15
ARCFACE_TOLERANCE=0.40
